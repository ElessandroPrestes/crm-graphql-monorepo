{
  "name": "nexo-crm",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "Nexo CRM \u2014 monorepo GraphQL (NestJS + React)",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm infra:up && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres redis rabbitmq",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:full": "docker compose -f infra/docker-compose.yml --profile full up --build",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:prepare": "pnpm --filter @nexo/shared build && pnpm --filter @nexo/api build",
    "e2e:db": "pnpm --filter @nexo/api db:deploy && pnpm --filter @nexo/api db:seed",
    "e2e:install": "playwright install --with-deps chromium",
    "test:e2e": "pnpm e2e:prepare && pnpm e2e:db && pnpm e2e"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nexo/eslint-config": "workspace:*",
    "@playwright/test": "1.65.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
