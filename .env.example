# Nexo CRM — ambiente local
# Copie para .env apenas se precisar sobrescrever os defaults locais.
# Nunca versione valores reais de produção.

NODE_ENV=development

# API
API_PORT=3202
CORS_ORIGINS=http://localhost:5217,http://nexo.localhost

# Worker
WORKER_PORT=3203
WORKER_PREFETCH=10

# Dados locais (credenciais de desenvolvimento, não usar em produção)
DATABASE_URL=postgresql://nexo:nexo@localhost:5402/nexo?schema=public
REDIS_URL=redis://localhost:8203
RABBITMQ_URL=amqp://nexo:nexo@localhost:8204

# Auth local (troque em produção; mínimo de 32 caracteres)
ACCESS_TOKEN_SECRET=dev-only-access-token-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=nexo_refresh

# Endurecimento HTTP/GraphQL
JSON_BODY_LIMIT=256kb
PERSISTED_QUERIES_MODE=audit
DATALOADER_ENABLED=true
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_EMAIL_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_SECONDS=900
RATE_LIMIT_GRAPHQL_USER_MAX=120
RATE_LIMIT_GRAPHQL_ANON_MAX=30
RATE_LIMIT_GRAPHQL_WRITE_MAX=40
RATE_LIMIT_GRAPHQL_WINDOW_SECONDS=60
RATE_LIMIT_WS_MAX=10
RATE_LIMIT_WS_WINDOW_SECONDS=60

# WhatsApp (mock local; cloud exige token e segredo em produção)
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=dev-only-whatsapp-verify-token
WHATSAPP_APP_SECRET=dev-only-whatsapp-app-secret
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
WHATSAPP_SEND_TIMEOUT_MS=10000
