# Nexo CRM — ambiente local
# Copie para .env apenas se precisar sobrescrever os defaults locais.
# Nunca versione valores reais de produção.

NODE_ENV=development

# API
API_PORT=3202
CORS_ORIGINS=http://localhost:5217,http://nexo.localhost

# Worker
WORKER_PORT=3203

# Dados locais (credenciais de desenvolvimento, não usar em produção)
DATABASE_URL=postgresql://nexo:nexo@localhost:5402/nexo?schema=public
REDIS_URL=redis://localhost:8203
RABBITMQ_URL=amqp://nexo:nexo@localhost:8204
