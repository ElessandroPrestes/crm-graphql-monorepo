{
  "name": "@nexo/api",
  "version": "0.3.0-alpha",
  "private": true,
  "type": "module",
  "description": "Nexo CRM GraphQL API (NestJS)",
  "scripts": {
    "predev": "pnpm db:generate",
    "dev": "nest start --watch",
    "prebuild": "pnpm db:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm db:generate",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "pretest:integration": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:benchmark": "tsx prisma/seed-benchmark.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "schema:generate": "pnpm build && node dist/schema/generate-schema.js",
    "schema:codegen": "pnpm --filter @nexo/graphql-schema codegen && pnpm persisted:generate",
    "schema:check": "pnpm schema:generate && pnpm schema:codegen && git diff --exit-code ../../packages/graphql-schema/schema.graphql ../../packages/graphql-schema/src/types.ts src/graphql/persisted-queries.generated.ts",
    "persisted:generate": "tsx scripts/generate-persisted-queries.ts",
    "persisted:check": "pnpm persisted:generate && git diff --exit-code src/graphql/persisted-queries.generated.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.2.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/graphql": "14.2.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.2",
    "@nexo/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "amqplib": "2.3.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dataloader": "2.2.3",
    "graphql": "16.15.0",
    "graphql-depth-limit": "1.1.0",
    "graphql-ws": "6.0.6",
    "helmet": "8.3.0",
    "ioredis": "5.8.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@nexo/graphql-schema": "workspace:*",
    "@nexo/tsconfig": "workspace:*",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "dotenv": "18.0.10",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
